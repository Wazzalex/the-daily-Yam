# Copy to .env.local for local development. Never commit the real key.
ANTHROPIC_API_KEY=sk-ant-...

# Premium voice (OpenAI speech) + audio storage (Vercel Blob). Without them, the phone's own voice is used.
OPENAI_API_KEY=sk-...
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Optional overrides (defaults are fine)
# YAM_AUDIO_DAILY_LIMIT=60
# YAM_FAST_MODEL=claude-haiku-5-5
# YAM_SMART_MODEL=claude-sonnet-5-5
# YAM_BOT_DAILY_LIMIT=200
